<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:maplibre="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Карта занимает весь экран; она появится после готовности офлайн-региона. -->
    <org.maplibre.android.maps.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        maplibre:maplibre_uiAttribution="true"
        maplibre:maplibre_uiLogo="true" />

    <!-- Верхняя панель показывает название приложения и число записей. -->
    <LinearLayout
        android:id="@+id/mapHeader"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="top"
        android:background="@color/surface_white"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:id="@+id/headerTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textColor="@color/primary_blue"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/wifiCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/wifi_count"
            android:textColor="@color/primary_blue"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Три кнопки повторяют основные действия веб-карты. -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:orientation="vertical"
        android:paddingEnd="12dp">

        <Button
            android:id="@+id/locationButton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="@string/my_location"
            android:text="◎"
            android:textSize="22sp" />

        <Button
            android:id="@+id/refreshButton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:contentDescription="@string/refresh_points"
            android:text="↻"
            android:textSize="22sp" />

        <Button
            android:id="@+id/nearestButton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:contentDescription="@string/nearest_point"
            android:text="★"
            android:textSize="20sp" />
    </LinearLayout>

    <!-- Короткий статус не перекрывает заголовок карты. -->
    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="72dp"
        android:background="@drawable/bg_point_card"
        android:elevation="3dp"
        android:paddingHorizontal="14dp"
        android:paddingVertical="8dp"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- Карточка появляется снизу, когда пользователь выбирает маркер. -->
    <include
        layout="@layout/view_wifi_point"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="12dp" />

    <!-- При первом запуске панель закрывает карту, пока файлы сохраняются. -->
    <include
        android:id="@+id/offlinePanel"
        layout="@layout/view_download_state"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</FrameLayout>
