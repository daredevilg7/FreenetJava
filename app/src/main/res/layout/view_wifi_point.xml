<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pointCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_point_card"
    android:elevation="8dp"
    android:orientation="vertical"
    android:padding="16dp"
    android:visibility="gone">

    <!-- В верхней строке показываем номер выбранной Wi-Fi-точки. -->
    <TextView
        android:id="@+id/pointTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/pointCoordinates"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="4dp"
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/pointDistance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="4dp"
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />

    <!-- Действия перенесены в карточку, чтобы их было удобно нажимать на телефоне. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/copyCoordinatesButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/copy_coordinates" />

        <Button
            android:id="@+id/openRouteButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/open_route" />
    </LinearLayout>
</LinearLayout>
